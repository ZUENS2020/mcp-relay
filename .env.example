# MCP Relay — environment examples
# Copy what you need. Never commit real tokens or passwords.

# --- Server (next to docker-compose) ---
# RELAY_ADMIN_USER=admin
# RELAY_ADMIN_PASSWORD=admin123
# RELAY_ADMIN_TOKEN=          # optional Bearer for MCP tools / scripts
# RELAY_MCP_ADMIN_TOKEN=     # defaults to RELAY_ADMIN_TOKEN in compose
# RELAY_SESSION_TTL_HOURS=168
# RELAY_AUTH_MODE=password    # password = built-in login; access = trust reverse proxy (Cloudflare Access)
# RELAY_BASE_URL=http://127.0.0.1:8740

# --- Agent config shape (~/.mcp-relay/config.yaml) ---
# relay_url: http://127.0.0.1:8740
# device_id: ""
# device_token: ""
# profile: ""
# targets: []
# allow_live_writes: false
