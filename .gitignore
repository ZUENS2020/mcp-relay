# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Go
agent/relay-agent
agent/relay-agent.exe
agent/*.exe
agent/relay_agent/

# Runtime / local data (never commit)
data/
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
deploy.zip
*.relay.bak

# Secrets / local agent state
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Build artifacts
dist/
/bin/
agent/bin/

# Platform binaries are produced by CI; keep placeholders in git, ignore large binaries locally
packages/*/bin/relay-agent
packages/*/bin/relay-agent.exe
!packages/*/bin/.gitkeep

